{
  "name": "color-grading-core",
  "version": "1.0.0",
  "description": "通用调色引擎核心：WebGL/WebGPU 双后端 + LUT 支持，被 image/video 调色库共享",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "color",
    "grading",
    "webgl",
    "webgpu",
    "lut",
    "shader",
    "调色"
  ],
  "license": "MIT",
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "terser": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  }
}
